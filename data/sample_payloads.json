{
  "description": "数据质量闸门示例提交载荷，可直接 POST 到 /batches/submit",
  "examples": [    {
      "name": "valid_orders_batch",
      "expect": "PASSED —— 批次通过并登记",
      "payload": {
        "batch_id": "demo-orders-0001",
        "schema_version": "order-schema/v2.1",
        "records": [
          {
            "order_id": "ORD-1001",
            "customer_email": "alice@example.com",
            "status": "active",
            "amount": 199.5,
            "currency": "CNY"
          },
          {
            "order_id": "ORD-1002",
            "customer_email": "bob@example.com",
            "status": "active",
            "amount": 42.0,
            "currency": "USD"
          },
          {
            "order_id": "ORD-1003",
            "customer_email": "carol@example.com",
            "status": "inactive",
            "amount": 0,
            "currency": "CNY"
          }
        ],
        "rules": {
          "field_rules": {
            "order_id": [
              {"type": "required"},
              {"type": "type", "value": "string"},
              {"type": "regex", "pattern": "^ORD-\\d{4}$"}
            ],
            "customer_email": [
              {"type": "required"},
              {"type": "type", "value": "string"},
              {"type": "max_length", "max_length": 128}
            ],
            "status": [
              {"type": "required"},
              {"type": "in", "values": ["active", "inactive", "pending"]}
            ],
            "amount": [
              {"type": "required"},
              {"type": "type", "value": "number"},
              {"type": "min", "min": 0},
              {"type": "max", "max": 1000000}
            ],
            "currency": [
              {"type": "required"},
              {"type": "in", "values": ["CNY", "USD", "EUR"]}
            ]
          },
          "unique_rules": [
            {"fields": ["order_id"]},
            {"fields": ["customer_email", "currency"]}
          ],
          "batch_rules": {
            "max_failure_rate": 0.0,
            "min_record_count": 1,
            "max_record_count": 10000
          }
        }
      }
    },
    {
      "name": "invalid_orders_batch",
      "expect": "FAILED —— 含字段约束失败、跨记录重复与批次阈值失败，且批次不可读",
      "payload": {
        "batch_id": "demo-orders-0002",
        "schema_version": "order-schema/v2.1",
        "records": [
          {
            "order_id": "ORD-2001",
            "customer_email": "dave@example.com",
            "status": "unknown",
            "amount": -50,
            "currency": "CNY"
          },
          {
            "order_id": "ORD-2002",
            "customer_email": "eve@example.com",
            "status": "active",
            "amount": 88,
            "currency": "JPY"
          },
          {
            "order_id": "ORD-2002",
            "customer_email": "frank",
            "status": "active",
            "amount": 77,
            "currency": "CNY"
          }
        ],
        "rules": {
          "field_rules": {
            "order_id": [
              {"type": "required"},
              {"type": "regex", "pattern": "^ORD-\\d{4}$"}
            ],
            "customer_email": [
              {"type": "required"},
              {"type": "max_length", "max_length": 128}
            ],
            "status": [
              {"type": "required"},
              {"type": "in", "values": ["active", "inactive", "pending"]}
            ],
            "amount": [
              {"type": "required"},
              {"type": "min", "min": 0},
              {"type": "max", "max": 1000000}
            ],
            "currency": [
              {"type": "required"},
              {"type": "in", "values": ["CNY", "USD", "EUR"]}
            ]
          },
          "unique_rules": [
            {"fields": ["order_id"]}
          ],
          "batch_rules": {
            "max_failure_rate": 0.0,
            "min_record_count": 5,
            "max_record_count": 10000
          }
        }
      }
    }
  ],
  "review_examples": [
    {
      "name": "gift_zero_amount_review",
      "description": "赠品 amount_cents=0（整数）触发 min 下界失败导致整批拒收；质控员复核豁免这两行后，按剩余错误重算并通过，以新批号登记",
      "steps": [
        {
          "step": 1,
          "method": "POST",
          "path": "/batches/submit",
          "expect": "FAILED —— 行 1、3 的赠品金额 0 触发 min 失败，失败率 0.5 超过阈值 0，整批拒收且不可读",
          "payload": {
            "batch_id": "demo-gift-0001",
            "schema_version": "order-schema/v3.0",
            "records": [
              {"order_id": "ORD-7001", "amount_cents": 19950},
              {"order_id": "ORD-7002", "amount_cents": 0},
              {"order_id": "ORD-7003", "amount_cents": 4200},
              {"order_id": "ORD-7004", "amount_cents": 0}
            ],
            "rules": {
              "field_rules": {
                "order_id": [
                  {"type": "required"},
                  {"type": "regex", "pattern": "^ORD-\\d{4}$"}
                ],
                "amount_cents": [
                  {"type": "required"},
                  {"type": "type", "value": "integer"},
                  {"type": "min", "min": 1}
                ]
              },
              "unique_rules": [{"fields": ["order_id"]}],
              "batch_rules": {
                "max_failure_rate": 0.0,
                "min_record_count": 1,
                "max_record_count": 100
              }
            }
          }
        },
        {
          "step": 2,
          "method": "POST",
          "path": "/batches/review",
          "expect": "PASSED —— 豁免行 1、3 amount_cents 整数 0 的 min 失败后无剩余错误，以新批号登记整批原始记录，报告注明来源批号与豁免行",
          "payload": {
            "source_batch_id": "demo-gift-0001",
            "batch_id": "demo-gift-0001-reviewed",
            "schema_version": "order-schema/v3.0",
            "records": [
              {"order_id": "ORD-7001", "amount_cents": 19950},
              {"order_id": "ORD-7002", "amount_cents": 0},
              {"order_id": "ORD-7003", "amount_cents": 4200},
              {"order_id": "ORD-7004", "amount_cents": 0}
            ],
            "rules": {
              "field_rules": {
                "order_id": [
                  {"type": "required"},
                  {"type": "regex", "pattern": "^ORD-\\d{4}$"}
                ],
                "amount_cents": [
                  {"type": "required"},
                  {"type": "type", "value": "integer"},
                  {"type": "min", "min": 1}
                ]
              },
              "unique_rules": [{"fields": ["order_id"]}],
              "batch_rules": {
                "max_failure_rate": 0.0,
                "min_record_count": 1,
                "max_record_count": 100
              }
            },
            "exempted_record_indexes": [1, 3]
          }
        },
        {
          "step": 3,
          "method": "GET",
          "path": "/batches/demo-gift-0001-reviewed",
          "expect": "200 —— 下游可读取复核通过的新批号整批记录（含赠品行）"
        },
        {
          "step": 4,
          "method": "GET",
          "path": "/batches/demo-gift-0001",
          "expect": "404 —— 原拒收批次仍不可读；其报告仍可通过 /submissions/demo-gift-0001 查询"
        }
      ]
    }
  ]
}
